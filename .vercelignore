# Exclude nested npm workspace SDK from Vercel web deployment
packages/

# Windows executables and heavy binaries
*.exe
app/*.exe
app/ldoc-server.exe
app/ldoc.exe

# Local scratch and test scripts
scratch/
test_*.js
*.log

# Non-web sources (Rust crates, specs, tools, backups)
source/
specs/
_backups/
examples/
LDOC_TOOLS/
tauri.conf.json
Cargo.toml
Cargo.lock

# Editor configs
.vscode
.idea
