# ==============================================================================
# LDOC STUDIO & LIVING DOCUMENT PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LEMON SQUEEZY MONETIZATION & PAYMENTS ($19 PRO LIFETIME LICENSE)
# ------------------------------------------------------------------------------
# Your Lemon Squeezy API Key (Dashboard > Settings > API Keys)
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here

# Your Store ID (Dashboard > Settings > Stores, e.g. 410862)
LEMON_SQUEEZY_STORE_ID=410862

# Product Variant ID for LDOC Studio Pro $19 tier (Dashboard > Products > Variants)
LEMON_SQUEEZY_VARIANT_ID=your_product_variant_id_here

# Webhook Signing Secret (Dashboard > Settings > Webhooks > Add Webhook)
# Endpoint URL: https://ldoc-studios.vercel.app/api/checkout/webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Payment provider mode (defaults to lemonsqueezy)
PAYMENT_PROVIDER=lemonsqueezy

# ------------------------------------------------------------------------------
# 2. GMAIL SMTP REAL-TIME LEAD ROUTING & DISPATCH
# ------------------------------------------------------------------------------
ADMIN_EMAIL=jayaramankalidasan@gmail.com
GMAIL_USER=jayaramankalidasan@gmail.com

# 16-character Google App Password (myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SIGNING & CLOUD USER AUTH
# ------------------------------------------------------------------------------
# 32+ character random secret for JWT user login tokens
JWT_SECRET=generate_random_32_char_secret_key_here_for_jwt

# 32+ character random secret for .ldocx package tamper-proof verification
PACKAGE_SIGNING_SECRET=generate_random_32_char_secret_key_here_for_packages

# ------------------------------------------------------------------------------
# 4. AI AGENTIC COPILOT (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
