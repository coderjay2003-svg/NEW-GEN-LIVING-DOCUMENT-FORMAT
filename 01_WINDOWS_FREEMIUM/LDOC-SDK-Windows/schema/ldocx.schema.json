{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LDOCX Document AST Schema",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.5.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1
    }
  }
}